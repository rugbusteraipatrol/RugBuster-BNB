# BasePay configuration.
#
# Copy to .env and fill in. Every variable is listed; the defaults shown are what
# the service uses when the variable is absent, so an empty .env with only
# DATABASE_URL set runs against Base mainnet.
#
# Secrets belong in your deployment's secret store, never in a committed file.

# ---------------------------------------------------------------------- core
# Required. Postgres connection string.
DATABASE_URL=postgres://basepay:basepay@localhost:5432/basepay
# HTTP port. Default: 8080
PORT=8080
# One of: fatal, error, warn, info, debug, trace, silent. Default: info
LOG_LEVEL=info
NODE_ENV=development

# --------------------------------------------------------------------- admin
# Bearer token for /admin/*. Leave unset to disable the admin API entirely.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional JSON file of merchants, applied (upserted) on every boot.
# A merchant's webhookSecret may be written as "env:NAME" to read it from the
# environment instead of the file. See config/merchants.json.
MERCHANTS_FILE=

# ------------------------------------------------------------------ sessions
# How long a quote is valid before it expires and releases its amount. Default: 900 (15 min)
SESSION_TTL_SECONDS=900

# Size of the unique-amount window, in micro-USDC. Each open session of a
# merchant holds one slot, so this is also the cap on that merchant's
# concurrent checkouts at any one price. 1000 slots = at most $0.000999 of
# overpay on a quote. Default: 1000
AMOUNT_OFFSET_MAX=1000

# A transfer below the quote is treated as an underpayment of that session only
# if it is at least this fraction of it; anything smaller is recorded unmatched.
# Default: 0.5
UNDERPAY_MIN_RATIO=0.5

# A transfer above the quote settles that session only if it is at most this
# multiple of it. Exists for the fiat on-ramp path, which cannot deliver an
# exact amount. Default: 1.1
OVERPAY_MAX_RATIO=1.1

# Session creations per minute per (merchant, IP). Protects the amount window
# from being exhausted by a single caller. Default: 30
SESSION_RATE_LIMIT_PER_MINUTE=30

# How often expired sessions are swept, in ms. Default: 10000
EXPIRY_SWEEP_INTERVAL_MS=10000

# ---------------------------------------------------------------- price feed
# Default: https://api.coingecko.com/api/v3
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko demo API key (sent as x-cg-demo-api-key).
COINGECKO_API_KEY=
# Serve the cached price without calling upstream for this long. Default: 60
PRICE_CACHE_TTL_SECONDS=60
# Refuse to open new sessions once the last good price is older than this,
# rather than quote a wrong amount. Must be >= PRICE_CACHE_TTL_SECONDS. Default: 600
PRICE_MAX_STALE_SECONDS=600
# Default: 5000
PRICE_REQUEST_TIMEOUT_MS=5000

# --------------------------------------------------------------------- chain
# Base mainnet. Change only for a local dev chain. Default: 8453
CHAIN_ID=8453
# USDC on Base. Default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Default: https://mainnet.base.org (fine to start with; use a dedicated
# provider in production, where the public endpoint's rate limits will bite).
BASE_RPC_HTTP_URL=https://mainnet.base.org
# Optional WebSocket RPC. When set it is preferred, with automatic HTTP fallback.
BASE_RPC_WS_URL=

# ------------------------------------------------------------------- watcher
# Default: true. Turning this off means sessions never settle.
WATCHER_ENABLED=true
# Default: 4000
WATCHER_POLL_INTERVAL_MS=4000
# Blocks per getLogs call. Lower it if your RPC provider rejects wide ranges. Default: 500
WATCHER_MAX_BLOCK_RANGE=500
# Block to start from on a cold start with no watcher_state row. Defaults to the
# chain head, which is right for a new deployment. Set it to re-scan history.
WATCHER_START_BLOCK=
# Confirmations before a session is marked paid and the merchant is notified. Default: 3
CONFIRMATIONS_REQUIRED=3
# How many blocks back to re-scan and re-validate every tick, to catch reorgs.
# Should comfortably exceed CONFIRMATIONS_REQUIRED. Default: 12
REORG_DEPTH_BLOCKS=12

# ------------------------------------------------------------------ webhooks
# Default: true
WEBHOOKS_ENABLED=true
# Attempts before a delivery becomes a dead letter. Default: 6
WEBHOOK_MAX_ATTEMPTS=6
# Default: 10000
WEBHOOK_TIMEOUT_MS=10000
# Default: 2000
WEBHOOK_WORKER_INTERVAL_MS=2000
# Backoff is base * 2^attempt seconds, plus jitter. Default: 5
WEBHOOK_BACKOFF_BASE_SECONDS=5

# ---------------------------------------------------------------------- http
# Comma-separated origins allowed to call the API, or * for any. The widget runs
# on the merchant's own domain, so this is normally that domain. Default: *
CORS_ALLOWED_ORIGINS=*
# Serve the built widget at /widget and the demo page at /demo. Default: true
SERVE_WIDGET=true
# Overrides for where those are read from. Default: ../widget/dist and ../widget/demo
WIDGET_DIST_DIR=
WIDGET_DEMO_DIR=
# Public origin of this service, for documentation and embed snippets.
PUBLIC_BASE_URL=

# ------------------------------------------------------------------- on-ramp
# One of: none, transak, moonpay. Default: none (the widget then shows only the
# wallet path).
ONRAMP_PROVIDER=none
TRANSAK_API_KEY=
# STAGING or PRODUCTION. Default: PRODUCTION
TRANSAK_ENVIRONMENT=PRODUCTION
MOONPAY_API_KEY=

# ----------------------------------------------------------------- dev/tests
# Used by the integration suites. Point it at a throwaway database: the tests
# truncate every table between cases.
TEST_DATABASE_URL=
# Optional: fork Base mainnet in the anvil watcher suite instead of deploying a
# stand-in token, so the tests run against the real USDC contract.
BASE_FORK_RPC_URL=
