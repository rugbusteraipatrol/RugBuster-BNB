{
  "name": "basepay",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial USDC-on-Base checkout: payment session service + embeddable widget.",
  "license": "MIT",
  "workspaces": [
    "server",
    "widget"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace server && npm run build --workspace widget",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace widget",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspace server",
    "test:unit": "npm run test:unit --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "migrate": "npm run migrate --workspace server",
    "dev": "npm run dev --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "type": "module"
}
